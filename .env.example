# Copy to .env and adjust. Used by docker compose for overrides.
# JWT_SECRET must be at least 32 bytes (see src/http/limits.rs).
JWT_SECRET=change-me-to-at-least-32-characters!!
# JWT_ISSUER=lufai_api
# JWT_ACCESS_TOKEN_TTL_SECS=86400
# RUST_LOG=info,lufai_api=debug

# Optional — payment flows
# PAYSTACK_SECRET_KEY=
# PAYSTACK_CALLBACK_URL=https://example.com/callback
